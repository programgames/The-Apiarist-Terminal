# Gradle
.gradle/
build/
out/
# Anchored: an unanchored bin/ matches every directory of that name at any depth, and the floppy's
# own usr/bin/ is one. Files already tracked survived it; new ones were silently never committed.
/bin/

# Gradle Wrapper - keep the wrapper jar
!gradle/wrapper/gradle-wrapper.jar

# ForgeGradle
run/
logs/
crash-reports/

# Eclipse
.classpath
.project
.settings/
*.launch

# IntelliJ IDEA
# IntelliJ: tout est local sauf les configurations d'execution, qui sont partagees.
# Il faut exclure le contenu (.idea/*) et non le dossier (.idea/), sinon git refuse de
# reinclure quoi que ce soit a l'interieur.
.idea/*
!.idea/runConfigurations/
*.iml
*.ipr
*.iws

# VSCode
.vscode/
*.code-workspace

# NetBeans
nbproject/
nbbuild/
dist/
nbdist/
.nb-gradle/

# macOS
.DS_Store
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~
.directory

# Minecraft
options.txt
optionsof.txt
servers.dat
usercache.json
usernamecache.json
realms_persistence.json
screenshots/
saves/
resourcepacks/
config/
mods/
*.log

# Compiled class files
*.class

# Package files
*.jar
# But keep the Gradle wrapper jar
!gradle/wrapper/gradle-wrapper.jar
# And keep local deobf jars if you use them
!libs/*-deobf.jar

# Virtual machine crash logs
hs_err_pid*.log

# Temporary files
*.tmp
*.bak
*.swp
*~.nib

# Sensitive data (if you add local credentials)
gradle-local.properties
local.properties

# Dossiers d'execution du client et du serveur de dev : mondes, configs et mods tiers.
# Les mods sont recuperes par `gradlew setupDevMods`, jamais versionnes.
run/
run-server/
